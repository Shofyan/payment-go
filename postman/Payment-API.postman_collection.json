		{
			"name": "Payments",
			"item": [
				{
					"name": "Create Payment - Credit Card",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test response status",
									"pm.test(\"Status code is 202 Accepted\", function () {",
									"    pm.response.to.have.status(202);",
									"});",
									"",
									"// Test response structure",
									"pm.test(\"Response has payment_id\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('payment_id');",
									"    pm.expect(jsonData).to.have.property('status');",
									"    pm.expect(jsonData).to.have.property('created_at');",
									"});",
									"",
									"// Save payment_id for subsequent requests",
									"var jsonData = pm.response.json();",
									"pm.environment.set(\"payment_id\", jsonData.payment_id);",
									"",
									"// Test response time",
									"pm.test(\"Response time is less than 500ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(500);",
									"});",
									"",
									"// Test payment status",
									"pm.test(\"Payment status is PENDING\", function () {",
									"    pm.expect(jsonData.status).to.equal(\"PENDING\");",
									"});"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Generate unique user ID for this request",
									"pm.environment.set(\"user_id\", \"user_\" + Date.now());"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"user_id\": \"{{user_id}}\",\n    \"merchant_id\": \"merchant_123\",\n    \"amount\": 10000,\n    \"currency\": \"USD\",\n    \"method\": \"CREDIT_CARD\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/payments",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"payments"
							]
						},
						"description": "Create a new payment with credit card.\n\n**Request Body:**\n- user_id: User identifier\n- merchant_id: Merchant identifier\n- amount: Amount in smallest currency unit (cents)\n- currency: ISO 4217 currency code (USD, EUR, etc.)\n- method: Payment method (CREDIT_CARD, DEBIT_CARD, WALLET, BANK_TRANSFER)\n\n**Response:**\n- 202 Accepted: Payment accepted for processing\n- 400 Bad Request: Invalid request data\n- 429 Too Many Requests: Rate limit exceeded\n- 503 Service Unavailable: System overloaded (backpressure)\n\n**Processing:**\nPayment is processed asynchronously by worker pool. Poll GET /payments/{id} for status."
					},
					"response": []
				},
